# Copy this file to .env.local for local development.
# On Vercel, add the same names under Settings → Environment Variables.
# Never commit real values.

# ---------------------------------------------------------------------------
# Email (SMTP). Used by the contact form and by every visitor alert.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=your_from_address@example.com
# Where "New lead" emails from the contact form go
CONTACT_TO=williampetersencop@gmail.com

# ---------------------------------------------------------------------------
# Visitor tracking
# ---------------------------------------------------------------------------
# Postgres connection string. Added automatically when you connect a Neon
# database to the project in Vercel (Storage → Create Database → Neon).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the private dashboard at /admin. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random text that signs the dashboard login cookie (32+ characters).
# Create one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-random-text

# Random text mixed into the IP fingerprint (32+ characters). The full IP
# address is never stored, only this fingerprint and a shortened address.
# Do not change it later, or returning visitors will not be recognised.
IP_HASH_SALT=replace-with-random-text

# Protects the scheduled jobs under /api/cron. Vercel sends it automatically.
CRON_SECRET=replace-with-random-text

# Where visitor alerts are sent. Can also be changed in Admin → Settings.
ALERT_EMAIL_TO=williampetersencop@gmail.com

# Optional: your public address, used for links inside emails,
# for example https://www.example.com. Detected automatically when empty.
SITE_URL=

# Optional: free token from ipinfo.io. Adds each visitor's internet provider.
# Leave empty to skip the lookup.
IPINFO_TOKEN=

# Optional, local testing only: save emails as files in this folder instead of
# sending them when SMTP is not configured.
# EMAIL_PREVIEW_DIR=.email-previews

# ---------------------------------------------------------------------------
# Password for the template's protected pages (not the dashboard)
# ---------------------------------------------------------------------------
PAGE_ACCESS_PASSWORD=password
